{
  "name": "hagicode-gallery",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run i18n:generate && astro dev --host 0.0.0.0",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; npm run i18n:generate && astro build",
    "preview": "astro preview",
    "check": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; npm run i18n:generate && astro check && tsc --noEmit",
    "verify": "npm run build && node scripts/verify-foundation.mjs",
    "deploy:payload": "node scripts/assemble-gh-pages-payload.mjs",
    "deploy:warmup": "node scripts/warm-deployment-domains.mjs",
    "test": "npm run i18n:generate && node --test \"scripts/__tests__/*.test.mjs\" && vitest run src",
    "i18n:generate": "node scripts/generate-i18n-resources.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs audit",
    "i18n:doctor": "node scripts/i18n-audit.mjs doctor",
    "i18n:sync": "hagi18n sync --config hagi18n.yaml --from en-US",
    "i18n:sync:write": "hagi18n sync --config hagi18n.yaml --from en-US --write",
    "i18n:check": "npm run i18n:audit && npm run i18n:doctor"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@hagicode/hagilight": "0.18.0",
    "@hagicode/hagilight-core": "0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@hagicode/hagi18n": "^0.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
