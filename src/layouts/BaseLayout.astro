---
import Footer from '@hagicode/hagilight/Footer';
import SEOHead from '@hagicode/hagilight/SEOHead';
import { resolveFaviconHeadEntry } from '@hagicode/hagilight-core/favicon';
import sharedFaviconUrl from '@hagicode/hagilight-core/favicon.ico';
import { DEFAULT_LOCALE, SITE_DESCRIPTION, SITE_NAME, type Locale } from '@/config/site';
import '@/styles/global.css';
import '@/styles/gallery.css';
import '@/styles/sky.css';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  // Absolute URL for the canonical link. Left unset, Hagilight uses the request path, which is right for every page
  // except one that Astro writes to a file name, such as 404.astro.
  canonical?: string;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  locale = DEFAULT_LOCALE,
  canonical,
} = Astro.props;

// hagilightFavicon() only edits Astro's config head, which this layout does not render. The shared
// icon is therefore supplied here, through SEOHead, so the page links it.
const faviconEntry = resolveFaviconHeadEntry([], { href: sharedFaviconUrl });
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SEOHead
      site={Astro.site}
      page={{ title, description, url: canonical }}
      head={faviconEntry ? [faviconEntry] : []}
      siteSeo={{ title: SITE_NAME, description: SITE_DESCRIPTION }}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="site-header">
      <a href={import.meta.env.BASE_URL} class="site-brand">{SITE_NAME}</a>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
