---
import AlbumCard from '@/components/gallery/AlbumCard.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadAlbums } from '@/lib/gallery/albums';

// The same memoized load serves the album pages, so each album's index is requested once per build.
const albums = await loadAlbums();
const total = albums.reduce((sum, loaded) => sum + loaded.index.range.count, 0);
const number = (value: number) => value.toLocaleString('en-US');
// Cards that fit in the first screen load their pictures at once; the rest wait until they are near.
const EAGER_CARDS = 4;
// The first album is shown larger only when there are enough neighbours to make a wall of it.
const featured = albums.length >= 3;
---

<BaseLayout>
  <header class="wall-intro">
    <h1>{SITE_NAME}</h1>
    <div class="wall-intro-aside">
      <p>{SITE_DESCRIPTION}</p>
      {
        albums.length > 0 && (
          <p class="wall-tally">
            <span>{number(albums.length)} {albums.length === 1 ? 'album' : 'albums'}</span>
            <span aria-hidden="true">/</span>
            <span>{number(total)} {total === 1 ? 'image' : 'images'}</span>
          </p>
        )
      }
    </div>
  </header>
  {
    albums.length === 0 ? (
      <p>No albums are published yet.</p>
    ) : (
      <ul class="album-wall" data-featured={featured ? '' : undefined} data-album-wall>
        {albums.map((loaded, position) => (
          <li class="min-w-0" style={`--i: ${position};`}>
            <AlbumCard loaded={loaded} eager={position < EAGER_CARDS} />
          </li>
        ))}
      </ul>
    )
  }
  <script>
    import '../scripts/gallery-client.ts';
  </script>
</BaseLayout>
