---
import AlbumCard from '@/components/gallery/AlbumCard.astro';
import { Separator } from '@/components/ui/separator';
import { SITE_DESCRIPTION, SITE_NAME } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadAlbums } from '@/lib/gallery/albums';

// The same memoized load serves the album pages, so each album's index is requested once per build.
const albums = await loadAlbums();
---

<BaseLayout>
  <div class="space-y-6">
    <h1>{SITE_NAME}</h1>
    <p>{SITE_DESCRIPTION}</p>
    <Separator />
    {
      albums.length === 0 ? (
        <p>No albums are published yet.</p>
      ) : (
        <ul class="grid list-none gap-4 p-0 sm:grid-cols-2">
          {albums.map((loaded) => (
            <li class="min-w-0">
              <AlbumCard loaded={loaded} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <script>
    import '../scripts/gallery-client.ts';
  </script>
</BaseLayout>
