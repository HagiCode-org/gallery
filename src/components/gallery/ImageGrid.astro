---
import { thumbnailFor, type LoadedAlbum } from '@/lib/gallery/albums';
import { objectUrl } from '@/lib/gallery/source';
import Thumb from './Thumb.astro';

interface Props {
  loaded: LoadedAlbum;
}

const { loaded } = Astro.props;

// Each item links to the full image, so the grid works without JavaScript. gallery-client.ts reads the data-* values
// to open the viewer and to upgrade thumbnails to cached copies. Index order is the order of the items.
const items = loaded.index.entries.map((entry, position) => {
  const thumbnail = thumbnailFor(loaded.index, entry);
  return {
    key: entry.key,
    position,
    href: objectUrl(entry.objectKey),
    bytes: entry.bytes,
    width: entry.width,
    height: entry.height,
    metadataUrl: entry.metadata ? objectUrl(entry.metadata.objectKey) : undefined,
    thumbnail,
  };
});
---

<ul class="gallery-grid list-none p-0" data-gallery-grid>
  {
    items.map((item) => (
      <li class="min-w-0" style={item.position < 24 ? `--i: ${item.position};` : undefined}>
        <a
          class="gallery-item"
          href={item.href}
          data-key={item.key}
          data-index={item.position}
          data-bytes={item.bytes}
          data-width={item.width}
          data-height={item.height}
          data-metadata={item.metadataUrl}
          aria-label={`${item.key} – ${loaded.album.title}`}
        >
          <Thumb thumb={item.thumbnail} class="gallery-thumb" cached eager={item.position < 12} />
          <span class="gallery-key">{item.key}</span>
          <span class="gallery-spot" aria-hidden="true"></span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  import '../../scripts/gallery-client.ts';
</script>
