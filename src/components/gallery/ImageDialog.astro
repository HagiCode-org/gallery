---
// The icons are authored here, one 24-unit grid and one 1.75 stroke, so every control in the viewer reads as a set.
import { DEFAULT_LOCALE, type Locale } from '@/config/site';
import { messagesFor, type ViewerScriptMessages } from '@/i18n/messages';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const m = messagesFor(locale).viewer;
// The strings the viewer script sets at run time. Everything else on the dialog is rendered here.
const scriptMessages: ViewerScriptMessages = {
  unknown: m.unknown,
  notPublished: m.notPublished,
  notLoaded: m.notLoaded,
  loading: m.loading,
  imageFailed: m.imageFailed,
  copy: m.copy,
  copied: m.copied,
  copyFailed: m.copyFailed,
  zoomIn: m.zoomIn,
  zoomOut: m.zoomOut,
  bytes: m.bytes,
};
---

<!-- A native modal dialog, the viewer. It stays closed without JavaScript; src/scripts/viewer.ts opens it from a
     thumbnail and fills every field with textContent, so prompt text is never parsed as markup. -->
<dialog id="gallery-dialog" class="gallery-dialog" aria-labelledby="gallery-dialog-title" data-gallery-dialog data-locale={locale} data-messages={JSON.stringify(scriptMessages)}>
  <div class="viewer" data-viewer>
    <div class="viewer-main">
      <div class="viewer-ambient" aria-hidden="true" data-viewer-ambient></div>
      <header class="viewer-bar">
        <div class="viewer-heading">
          <h2 id="gallery-dialog-title" class="viewer-title" data-dialog-title></h2>
          <p class="viewer-count" data-viewer-count aria-hidden="true"></p>
        </div>
        <div class="viewer-actions">
          <button type="button" class="viewer-button" data-viewer-zoom aria-label={m.zoomIn} title={m.zoomTitle}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5M8 11h6M11 8v6" data-zoom-plus></path></svg>
          </button>
          <button type="button" class="viewer-button" data-dialog-info aria-expanded="false" aria-controls="viewer-panel" aria-label={m.details} title={m.detailsTitle}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
          </button>
          <button type="button" class="viewer-button" data-dialog-close aria-label={m.close} title={m.closeTitle}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
      </header>
      <div class="viewer-stage" data-viewer-stage>
        <figure class="viewer-figure" data-dialog-figure></figure>
      </div>
      <button type="button" class="viewer-nav viewer-nav-previous" data-dialog-previous aria-label={m.previous} title={m.previousTitle}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button type="button" class="viewer-nav viewer-nav-next" data-dialog-next aria-label={m.next} title={m.nextTitle}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>
    <aside id="viewer-panel" class="viewer-panel" aria-label={m.panelLabel} tabindex="0" data-viewer-panel inert>
      <!-- Sits above the facts so a load failure is read next to the prompts it explains. Empty, it takes no room. -->
      <p class="viewer-status" role="status" data-dialog-status></p>
      <!-- The prompts lead: they are what a visitor opens the panel for. The short facts follow as a group. -->
      <dl class="gallery-facts min-w-0">
        <div class="gallery-prompt">
          <dt>
            {m.positivePrompt}
            <button type="button" class="viewer-copy" data-copy="positive" disabled>{m.copy}</button>
          </dt>
          <dd data-field="positive"></dd>
        </div>
        <div class="gallery-prompt" data-secondary>
          <dt>
            {m.negativePrompt}
            <button type="button" class="viewer-copy" data-copy="negative" disabled>{m.copy}</button>
          </dt>
          <dd data-field="negative"></dd>
        </div>
        <div class="gallery-fact gallery-fact-wide">
          <dt>{m.key}</dt>
          <dd data-fact="key"></dd>
        </div>
        <div class="gallery-fact">
          <dt>{m.pixelSize}</dt>
          <dd data-fact="size"></dd>
        </div>
        <div class="gallery-fact">
          <dt>{m.byteSize}</dt>
          <dd data-fact="bytes"></dd>
        </div>
        <div class="gallery-fact">
          <dt>{m.seed}</dt>
          <dd data-field="seed"></dd>
        </div>
        <div class="gallery-fact">
          <dt>{m.generated}</dt>
          <dd data-field="generatedAt"></dd>
        </div>
      </dl>
    </aside>
  </div>
</dialog>
