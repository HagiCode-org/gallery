---
// The icons are authored here, one 24-unit grid and one 1.75 stroke, so every control in the viewer reads as a set.
---

<!-- A native modal dialog, the viewer. It stays closed without JavaScript; src/scripts/viewer.ts opens it from a
     thumbnail and fills every field with textContent, so prompt text is never parsed as markup. -->
<dialog id="gallery-dialog" class="gallery-dialog" aria-labelledby="gallery-dialog-title" data-gallery-dialog>
  <div class="viewer" data-viewer>
    <div class="viewer-main">
      <div class="viewer-ambient" aria-hidden="true" data-viewer-ambient></div>
      <header class="viewer-bar">
        <div class="viewer-heading">
          <h2 id="gallery-dialog-title" class="viewer-title" data-dialog-title></h2>
          <p class="viewer-count" data-viewer-count aria-hidden="true"></p>
        </div>
        <div class="viewer-actions">
          <button type="button" class="viewer-button" data-viewer-zoom aria-label="Zoom in" title="Zoom (+ / −)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5M8 11h6M11 8v6" data-zoom-plus></path></svg>
          </button>
          <button type="button" class="viewer-button" data-dialog-info aria-expanded="false" aria-controls="viewer-panel" aria-label="Details" title="Details (I)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
          </button>
          <button type="button" class="viewer-button" data-dialog-close aria-label="Close" title="Close (Esc)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
      </header>
      <div class="viewer-stage" data-viewer-stage>
        <figure class="viewer-figure" data-dialog-figure></figure>
      </div>
      <button type="button" class="viewer-nav viewer-nav-previous" data-dialog-previous aria-label="Previous image" title="Previous (←)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      </button>
      <button type="button" class="viewer-nav viewer-nav-next" data-dialog-next aria-label="Next image" title="Next (→)">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
      </button>
    </div>
    <aside id="viewer-panel" class="viewer-panel" aria-label="Image details" tabindex="0" data-viewer-panel inert>
      <dl class="gallery-facts min-w-0">
        <dt>Key</dt>
        <dd data-fact="key"></dd>
        <dt>Pixel size</dt>
        <dd data-fact="size"></dd>
        <dt>Byte size</dt>
        <dd data-fact="bytes"></dd>
        <dt>
          Positive prompt
          <button type="button" class="viewer-copy" data-copy="positive" disabled>Copy</button>
        </dt>
        <dd data-field="positive"></dd>
        <dt>
          Negative prompt
          <button type="button" class="viewer-copy" data-copy="negative" disabled>Copy</button>
        </dt>
        <dd data-field="negative"></dd>
        <dt>Seed</dt>
        <dd data-field="seed"></dd>
        <dt>Generated</dt>
        <dd data-field="generatedAt"></dd>
      </dl>
      <p class="viewer-status" role="status" data-dialog-status></p>
    </aside>
  </div>
</dialog>
