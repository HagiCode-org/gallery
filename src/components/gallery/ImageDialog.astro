<!-- A native modal dialog. It stays closed without JavaScript; gallery-client.ts opens it from a thumbnail and fills every
     field with textContent, so prompt text is never parsed as markup. -->
<dialog id="gallery-dialog" class="gallery-dialog" aria-labelledby="gallery-dialog-title" data-gallery-dialog>
  <div class="flex min-w-0 flex-col gap-4 p-4">
    <div class="flex min-w-0 items-start justify-between gap-3">
      <h2 id="gallery-dialog-title" class="min-w-0 break-all text-base font-semibold leading-snug" data-dialog-title></h2>
      <button type="button" class="gallery-button" data-dialog-close>Close</button>
    </div>
    <figure class="m-0 min-w-0" data-dialog-figure></figure>
    <div class="flex min-w-0 gap-2">
      <button type="button" class="gallery-button flex-1" data-dialog-previous>Previous</button>
      <button type="button" class="gallery-button flex-1" data-dialog-next>Next</button>
    </div>
    <dl class="gallery-facts min-w-0">
      <dt>Key</dt>
      <dd data-fact="key"></dd>
      <dt>Pixel size</dt>
      <dd data-fact="size"></dd>
      <dt>Byte size</dt>
      <dd data-fact="bytes"></dd>
      <dt>Positive prompt</dt>
      <dd data-field="positive"></dd>
      <dt>Negative prompt</dt>
      <dd data-field="negative"></dd>
      <dt>Seed</dt>
      <dd data-field="seed"></dd>
      <dt>Generated</dt>
      <dd data-field="generatedAt"></dd>
    </dl>
    <p class="m-0 text-sm" role="status" data-dialog-status></p>
  </div>
</dialog>
