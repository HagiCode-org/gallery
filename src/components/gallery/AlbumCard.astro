---
import type { CSSProperties } from 'react';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { backgroundStyle, dominantAspect, isPending, type LoadedAlbum } from '@/lib/gallery/albums';
import { DEFAULT_LOCALE, type Locale } from '@/config/site';
import { albumText } from '@/i18n/albums';
import { formatCount, localePath } from '@/i18n/locales';
import { messagesFor } from '@/i18n/messages';
import { coverFragment } from '@/lib/gallery/home';
import type { HomePicture } from '@/lib/gallery/homeThumbs';
import Thumb from './Thumb.astro';

interface Props {
  loaded: LoadedAlbum;
  // The pictures chosen for this build, cover first. The card fans the first three.
  pictures: readonly HomePicture[];
  locale?: Locale;
  // The first screen's cards load their pictures at once.
  eager?: boolean;
}

const { loaded, pictures, locale = DEFAULT_LOCALE, eager = false } = Astro.props;
const text = albumText(loaded.album, locale);
const stack = pictures.slice(0, 3);
const [cover] = stack;
const count = loaded.index.range.count;
// Opens the album at the picture shown as its cover.
const href = `${localePath(locale, `/albums/${loaded.album.slug}/`)}${cover ? coverFragment(cover.key) : ''}`;
const ratio = dominantAspect(loaded.index);
const [ratioWidth = 1, ratioHeight = 1] = ratio.split(' / ').map(Number);
// The React Card takes a style object; the custom properties are what the stylesheet sizes the art from.
const cardStyle = { '--ratio': ratio, '--ratio-n': (ratioWidth / ratioHeight).toFixed(4) } as CSSProperties;
const titleId = `album-${loaded.album.slug}-title`;
---

<Card
  className="album-card gap-0 py-0"
  data-album-card
  style={cardStyle}
>
  <div class="album-art" aria-hidden="true">
    {cover && <span class="album-wash" style={backgroundStyle(cover.small)} />}
    {
      stack.length > 0 && (
        <div class="album-stack">
          {
            // Painted back to front: the cover is the first of the stack but the last one drawn, so it sits on top.
            [...stack].reverse().map((picture, drawn) => {
              const depth = stack.length - 1 - drawn;
              return (
                <Thumb
                  thumb={picture.card}
                  class={`album-sheet album-sheet-${depth}`}
                  eager={eager && depth === 0}
                  alt={depth === 0 ? text.title : ''}
                  style={depth === 0 ? `view-transition-name: cover-${loaded.album.slug};` : ''}
                />
              );
            })
          }
        </div>
      )
    }
    <span class="album-spot"></span>
  </div>
  <CardHeader className="album-body gap-1.5 px-4 pt-4">
    <CardTitle>
      <h2 id={titleId} class="album-title">
        <a href={href} class="album-link" data-album-link>{text.title}</a>
      </h2>
    </CardTitle>
    <CardDescription>{text.description}</CardDescription>
  </CardHeader>
  <CardContent className="px-4 pb-4 pt-3">
    <Badge variant="secondary" className="album-count">
      {isPending(loaded) ? messagesFor(locale).album.pending : formatCount(locale, messagesFor(locale).images, count)}
    </Badge>
  </CardContent>
</Card>
