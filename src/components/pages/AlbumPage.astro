---
import ImageDialog from '@/components/gallery/ImageDialog.astro';
import ImageGrid from '@/components/gallery/ImageGrid.astro';
import Thumb from '@/components/gallery/Thumb.astro';
import { DEFAULT_LOCALE, SITE_NAME, type Locale } from '@/config/site';
import { albumText } from '@/i18n/albums';
import { formatCount, localePath } from '@/i18n/locales';
import { messagesFor } from '@/i18n/messages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { backgroundStyle, coverFor, dominantAspect, type LoadedAlbum } from '@/lib/gallery/albums';

interface Props {
  loaded: LoadedAlbum;
  locale?: Locale;
}

const { loaded, locale = DEFAULT_LOCALE } = Astro.props;
const messages = messagesFor(locale);
const text = albumText(loaded.album, locale);
const count = loaded.index.range.count;
const backHref = localePath(locale, '/');
const cover = coverFor(loaded);
const ratio = dominantAspect(loaded.index);
const [ratioWidth = 1, ratioHeight = 1] = ratio.split(' / ').map(Number);
---

<BaseLayout
  title={`${text.title} · ${SITE_NAME}`}
  description={text.description}
  locale={locale}
  pagePath={`/albums/${loaded.album.slug}/`}
>
  <div class="album-page" style={`--ratio: ${ratio}; --ratio-n: ${(ratioWidth / ratioHeight).toFixed(4)};`}>
    {cover && <div class="album-bleed" aria-hidden="true" style={backgroundStyle(cover)} />}
    <nav class="album-bar" aria-label={messages.album.nav} data-album-bar>
      <a href={backHref} class="album-back">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
        {messages.album.back}
      </a>
      <span class="album-bar-title" aria-hidden="true">{text.title}</span>
      <span class="album-range" data-album-range hidden></span>
      <div class="density" role="group" aria-label={messages.album.thumbnailSize} data-density-control hidden>
        <button type="button" data-density-step="small" aria-label={messages.album.small} title={messages.album.small} aria-pressed="false">S</button>
        <button type="button" data-density-step="medium" aria-label={messages.album.medium} title={messages.album.medium} aria-pressed="true">M</button>
        <button type="button" data-density-step="large" aria-label={messages.album.large} title={messages.album.large} aria-pressed="false">L</button>
      </div>
      <span class="album-progress" aria-hidden="true"></span>
    </nav>
    <header class="album-hero">
      <div class="album-hero-text">
        <h1>{text.title}</h1>
        <p>{text.description}</p>
        <p class="album-count-line">{formatCount(locale, messages.images, count)}</p>
      </div>
      {
        cover && (
          <div class="album-hero-art" aria-hidden="true">
            <Thumb thumb={cover} class="album-hero-image" eager cached style={`view-transition-name: cover-${loaded.album.slug};`} />
          </div>
        )
      }
    </header>
    {count > 0 && <ImageGrid loaded={loaded} locale={locale} />}
    <ImageDialog locale={locale} />
  </div>
</BaseLayout>
