---
import AlbumCard from '@/components/gallery/AlbumCard.astro';
import Thumb from '@/components/gallery/Thumb.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { albumText } from '@/i18n/albums';
import { formatCount, localePath } from '@/i18n/locales';
import { messagesFor } from '@/i18n/messages';
import { coverFor, isPending, loadAlbums, stackFor, type LoadedAlbum, type Thumbnail } from '@/lib/gallery/albums';
import { ogImageFor } from '@/lib/gallery/ogImage';
import { homeStructuredData } from '@/lib/seo';
import { layoutSky, narrowFieldRem, satellitesPerStar } from '@/lib/gallery/constellation';
import { DEFAULT_LOCALE, SITE_NAME, type Locale } from '@/config/site';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const messages = messagesFor(locale);

// The same memoized load serves the album pages, so each album's index is requested once per build.
const albums = await loadAlbums();
const total = albums.reduce((sum, loaded) => sum + loaded.index.range.count, 0);
const images = (count: number) => formatCount(locale, messages.images, count);
// Cards that fit in the first screen load their pictures at once; the rest wait until they are near.
const EAGER_CARDS = 4;
// The first album is shown larger only when there are enough neighbours to make a wall of it.
const featured = albums.length >= 3;

// One star per album, placed by the same geometry on every build. Its covers and the small pictures that hang off it are
// real images from the album's own index.
// An album with no images yet has nothing to show in the sky, so it appears on the wall only.
const skyAlbums = albums.filter((loaded) => !isPending(loaded));
const bodies = layoutSky(skyAlbums.map((loaded) => loaded.index.range.count));
const hanging = satellitesPerStar(skyAlbums.length);
const stars = skyAlbums.flatMap((loaded, position) => {
  const body = bodies[position];
  const cover = coverFor(loaded);
  if (!body || !cover) return [];
  // The evenly spread pictures after the cover. Fewer than asked for when the album is short.
  const extras: Thumbnail[] = stackFor(loaded, hanging + 1).slice(1);
  return [{ loaded, position, body, cover, extras }];
});
const [firstAlbum] = skyAlbums;
const structuredData = homeStructuredData(
  locale,
  messages.siteDescription,
  albums.map((loaded) => ({ slug: loaded.album.slug, title: albumText(loaded.album, locale).title })),
);
const skyStyle = `--n:${skyAlbums.length};--field:${narrowFieldRem(skyAlbums.length)}rem;`;
const starStyle = (position: number, size: number, wx: number, wy: number, nx: number, ny: number) =>
  `--i:${position};--s:${size};--wx:${wx}%;--wy:${wy}%;--nx:${nx}%;--ny:${ny}%;`;
const label = (loaded: LoadedAlbum) =>
  `${albumText(loaded.album, locale).title}, ${isPending(loaded) ? messages.album.pending : images(loaded.index.range.count)}`;
const albumHref = (loaded: LoadedAlbum) => localePath(locale, `/albums/${loaded.album.slug}/`);
---

<BaseLayout
  locale={locale}
  pagePath="/"
  image={firstAlbum ? await ogImageFor(firstAlbum) : undefined}
  structuredData={structuredData}
>
  <section class="sky" data-sky style={skyStyle} aria-labelledby="sky-title">
    <canvas class="sky-canvas" data-sky-canvas aria-hidden="true"></canvas>
    <div class="sky-copy">
      <h1 id="sky-title">{SITE_NAME}</h1>
      <p class="sky-lede">
        {messages.home.lede}
      </p>
      <a class="sky-cta" href="#albums">
        {messages.home.browse}
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 3v10M3.5 8.5 8 13l4.5-4.5"></path>
        </svg>
      </a>
    </div>
    {
      stars.length > 0 && (
        <ul class="sky-field" data-sky-field>
          {stars.map(({ loaded, position, body, cover, extras }) => (
            <li
              class="sky-node"
              data-sky-node
              style={starStyle(position, body.size, body.wideX, body.wideY, body.narrowX, body.narrowY)}
            >
              <a
                class="sky-star"
                href={albumHref(loaded)}
                aria-label={label(loaded)}
                data-sky-star
              >
                <span class="sky-cover" aria-hidden="true">
                  <Thumb thumb={cover} class="sky-img" eager={position < 5} cached alt={albumText(loaded.album, locale).title} />
                </span>
                <span class="sky-label" aria-hidden="true">
                  <strong>{albumText(loaded.album, locale).title}</strong>
                  <span class="sky-count">{images(loaded.index.range.count)}</span>
                </span>
              </a>
              {extras.map((thumb, step) => {
                const satellite = body.satellites[step];
                return satellite ? (
                  <span
                    class="sky-sat"
                    data-sky-sat
                    aria-hidden="true"
                    style={`--sx:${satellite.sx};--sy:${satellite.sy};--ss:${satellite.size};--k:${step};`}
                  >
                    <Thumb thumb={thumb} class="sky-img" />
                  </span>
                ) : null;
              })}
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <section class="wall" id="albums" aria-labelledby="albums-title">
    <div class="wall-head">
      <p class="wall-title" id="albums-title">{messages.home.albumsHeading}</p>
      {
        albums.length > 0 && (
          <p class="wall-tally">
            <span>{formatCount(locale, messages.albums, albums.length)}</span>
            <span aria-hidden="true">/</span>
            <span>{images(total)}</span>
          </p>
        )
      }
    </div>
    {
      albums.length === 0 ? (
        <p>{messages.home.empty}</p>
      ) : (
        <ul class="album-wall" data-featured={featured ? '' : undefined} data-album-wall aria-labelledby="albums-title">
          {albums.map((loaded, position) => (
            <li class="min-w-0" style={`--i: ${position};`}>
              <AlbumCard loaded={loaded} locale={locale} eager={position < EAGER_CARDS} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <script>
    import '../../scripts/gallery-client.ts';
    import '../../scripts/sky.ts';
  </script>
</BaseLayout>
